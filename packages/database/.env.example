# Used by the Prisma CLI (generate / migrate / seed) via prisma.config.ts.
# Must match the DATABASE_URL in apps/portal/.env and apps/admin/.env.
#
# Default points at the optional local Postgres from the root docker-compose.yml:
#   bun run db:up
#
# Schema changes are applied from prisma/migrations/ — `bun run cli db:setup`
# locally (migrate dev + seed), `bun run cli db:migrate` in a release step
# (migrate deploy, never seeds). The seed only auto-runs against a local host;
# a non-local URL needs an explicit `--seed` plus SEED_PASSWORD.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_starter?schema=public"
