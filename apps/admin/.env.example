# Copy to apps/admin/.env and fill in. DATABASE_URL must match packages/database/.env.

# Default points at the optional local Postgres from the root docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_starter?schema=public"

# Better Auth. Both have safe localhost defaults in dev; set a strong secret for
# any shared/deployed environment.
# BETTER_AUTH_URL="http://localhost:5510"
# BETTER_AUTH_SECRET=""

# Extra origins Better Auth should trust for its Origin/CSRF check, beyond the two
# localhost dev ports (always trusted). Required for apex/www, custom domains, or
# preview URLs in any deployed environment. Comma-separated.
# TRUSTED_ORIGINS="https://example.com,https://www.example.com"
