{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install --production=false && bunx turbo run build --filter=portal",
    "watchPatterns": ["apps/portal/**", "packages/**"]
  },
  "deploy": {
    "startCommand": "cd apps/portal && bun run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
