# Copy to apps/portal/.env and fill in. DATABASE_URL must match packages/database/.env.

# Default points at the optional local Postgres from the root docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_starter?schema=public"

# Better Auth. Both have safe localhost defaults in dev; set a strong secret for
# any shared/deployed environment.
# BETTER_AUTH_URL="http://localhost:5520"
# BETTER_AUTH_SECRET=""
