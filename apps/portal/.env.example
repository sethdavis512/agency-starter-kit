# Copy to apps/portal/.env and fill in. DATABASE_URL must match packages/database/.env.

# Default points at the optional local Postgres from the root docker-compose.yml.
# DATABASE_URL is also needed at BUILD time, not only at runtime: `turbo run build`
# runs `prisma generate`, which loads it through packages/database/prisma.config.ts
# and fails when it is unset. Nothing connects during the build, so any well-formed
# Postgres URL satisfies it (`docker build --build-arg DATABASE_URL=...`); on Railway
# set the real value on the service before the first deploy — service variables are
# available to the build as well.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_starter?schema=public"

# Better Auth. BETTER_AUTH_URL is required — @repo/auth is shared by both apps, so it
# cannot default to either app's port, and throws at boot if unset. BETTER_AUTH_SECRET
# is required in any shared/deployed environment — an unset secret falls back to
# Better Auth's public default in dev (forgeable) and throws at boot in production.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:5520"
BETTER_AUTH_SECRET="replace-with-a-generated-secret-openssl-rand-base64-32"

# Extra origins Better Auth should trust for its Origin/CSRF check, beyond the two
# localhost dev ports (always trusted). Required for apex/www, custom domains, or
# preview URLs in any deployed environment. Comma-separated.
# TRUSTED_ORIGINS="https://example.com,https://www.example.com"

# Observability. LOG_LEVEL sets the minimum level for the JSON logger in
# @repo/utils/logger (debug | info | warn | error | silent; default info). Every
# unhandled request error is logged as one JSON line by handleError in
# app/entry.server.tsx. SENTRY_DSN is reserved for the error-reporting hook in
# that same handleError — no SDK is installed yet; see "Security headers and
# logging" in CLAUDE.md for how to wire one in.
# LOG_LEVEL="info"
# SENTRY_DSN=""
