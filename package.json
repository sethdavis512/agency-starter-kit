{
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1.2.17"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:portal": "PLAYWRIGHT_ARTIFACT_SUFFIX=portal playwright test --config playwright.config.ts --project=portal",
    "e2e:admin": "PLAYWRIGHT_ARTIFACT_SUFFIX=admin playwright test --config playwright.config.ts --project=admin",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:report:portal": "playwright show-report playwright-report/portal",
    "e2e:report:admin": "playwright show-report playwright-report/admin",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "cli": "bun apps/cli/src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "vitest": "^4.1.9"
  },
  "name": "agency-starter-kit",
  "packageManager": "bun@1.2.17",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
